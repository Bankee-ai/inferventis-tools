{
  "name": "financial_calculator_basic",
  "version": "1.0.0",
  "pricingTier": "standard",
  "description": "Financial calculator tool. Does financial math. Input: calculator type and numbers. Returns result.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "calculator_type": { "type": "string", "description": "Type of calculation." },
      "principal": { "type": "number", "description": "Amount." },
      "rate": { "type": "number", "description": "Rate." },
      "periods": { "type": "number", "description": "Periods." },
      "initial_value": { "type": "number", "description": "Initial value." },
      "final_value": { "type": "number", "description": "Final value." }
    },
    "required": ["calculator_type"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "calculator_type": { "type": "string" },
      "result": { "type": "number" }
    }
  }
}
