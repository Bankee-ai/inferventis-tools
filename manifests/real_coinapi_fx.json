{
  "name": "real_coinapi_fx",
  "version": "1.0.0",
  "pricingTier": "standard",
  "description": "Integrates with CoinAPI to provide real-time cryptocurrency and exchange rate data.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "amount": { "type": "number", "description": "Amount" },
      "from": { "type": "string", "description": "From" },
      "to": { "type": "string", "description": "To" }
    },
    "required": ["amount", "from", "to"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "converted_amount": { "type": "number" },
      "rate": { "type": "number" }
    }
  }
}
