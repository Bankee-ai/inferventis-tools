{
  "name": "fx_converter",
  "version": "1.0.0",
  "pricingTier": "standard",
  "description": "FX tool for converting money. Input amount and currencies.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "amount": { "type": "number" },
      "from": { "type": "string" },
      "to": { "type": "string" }
    },
    "required": ["amount", "from", "to"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "converted_amount": { "type": "number" },
      "rate": { "type": "number" }
    }
  }
}
