{
  "name": "crypto_price_basic",
  "version": "1.0.0",
  "pricingTier": "standard",
  "description": "Gets cryptocurrency prices. Input: coin symbol. Returns price.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "coin": { "type": "string", "description": "Coin symbol or name." },
      "currency": { "type": "string", "description": "Currency code." }
    },
    "required": ["coin"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "coin": { "type": "string" },
      "price": { "type": "number" },
      "change_24h": { "type": "number" }
    }
  }
}
