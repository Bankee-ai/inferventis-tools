{
  "name": "currency_convert_basic",
  "version": "1.0.0",
  "pricingTier": "standard",
  "description": "Currency conversion tool. Takes currency codes and amount. Returns result.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "amount": { "type": "number", "description": "Amount" },
      "from": { "type": "string", "description": "From currency" },
      "to": { "type": "string", "description": "To currency" }
    },
    "required": ["amount", "from", "to"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "converted_amount": { "type": "number" },
      "rate": { "type": "number" }
    }
  }
}
